# API Configuration
VITE_API_URL=http://localhost:3000

# Application Configuration
VITE_APP_NAME=Budgeting Tool
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PLAID=false
VITE_ENABLE_BILL_TRACKING=true
VITE_ENABLE_INVESTMENTS=true

# Plaid Configuration (if enabled)
VITE_PLAID_CLIENT_ID=
VITE_PLAID_ENV=development

# Monitoring & Observability (Optional)
# Sentry - Error tracking (https://sentry.io)
VITE_SENTRY_DSN=https://your-sentry-dsn@oxxxxx.ingest.sentry.io/xxxxx

# Google Analytics - Usage analytics (https://analytics.google.com)
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
